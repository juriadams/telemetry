{
  "name": "@juriadams/telemetry",
  "description": "Lightweight and dead-simple library for collecting telemetry data.",
  "version": "0.0.2",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "package.json",
    "readme.md",
    "changelog.md"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "exports": "attw --pack . --profile esm-only",
    "lint": "biome lint . && biome check .",
    "format": "biome lint --write . && biome format --write . && biome check --write .",
    "release": "bun run build && bun publish --access public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@biomejs/biome": "2.3.1",
    "@types/bun": "latest",
    "obuild": "0.3.0"
  },
  "peerDependencies": {
    "typescript": "5.9.2"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  }
}
